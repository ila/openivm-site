---
import Base from '../layouts/Base.astro';
import CodeTabs from '../components/CodeTabs.astro';
import DeltaDemo from '../components/DeltaDemo.astro';
import ArchDiagram from '../components/ArchDiagram.astro';
import CrossSystemDiagram from '../components/CrossSystemDiagram.astro';

// Output of the DuckDB extension at main ac39a1f0 (SET openivm_files_path). Internal names use the view key,
// abbreviated to <key>; catalog prefixes and literal timestamps are elided, long statements are wrapped.
const compiled = [
  {
    label: '1 · Your view',
    note: 'A grouped aggregate over one table. This is all you write.',
    code: `CREATE MATERIALIZED VIEW regional_totals AS
    SELECT region, SUM(amount) AS total, COUNT(*) AS cnt
    FROM sales
    GROUP BY region;`,
  },
  {
    label: '2 · Setup DDL',
    note: 'The view is stored in <code>openivm_data_&lt;key&gt;</code> with a hidden non-NULL count, so a group that loses all its values returns NULL rather than 0. Readers see <code>openivm_visible_&lt;key&gt;</code>, the published result, through a plain view. Changes to <code>sales</code> are captured in <code>openivm_delta_sales</code>.',
    code: `CREATE TABLE openivm_data_<key> AS
SELECT    region, sum(amount) AS total, count_star() AS cnt,
          count(amount) AS openivm_nonnull_sum_count_1
FROM      sales
GROUP BY  region;

CREATE TABLE openivm_visible_<key> AS
    SELECT * EXCLUDE (openivm_nonnull_sum_count_1), CAST(0 AS BIGINT) AS openivm_ordinal
    FROM openivm_data_<key>;

CREATE VIEW regional_totals AS
    SELECT * EXCLUDE (openivm_ordinal) FROM openivm_visible_<key>;

CREATE UNIQUE INDEX openivm_data_<key>openivm_index ON openivm_data_<key>(region);`,
  },
  {
    label: '3 · ΔT → ΔV',
    note: "On refresh, only rows newer than the view's cursor are read. Duplicate deltas are consolidated first (a +1 and a −1 for the same tuple cancel), then the aggregate is applied to the delta itself, keeping the multiplicity as a group key.",
    code: `WITH
t0_scan (t0_region, t0_amount, t0_openivm_multiplicity) AS (
    SELECT  region, amount, openivm_multiplicity
    FROM    openivm_delta_sales
    WHERE   openivm_timestamp >= $last_update
),
t1_aggregate (t8_region, t8_amount, t9_openivm_multiplicity) AS (
    SELECT    t0_region, t0_amount, sum(t0_openivm_multiplicity)
    FROM      t0_scan
    GROUP BY  t0_region, t0_amount
),
t2_block (t2_region, total, cnt, openivm_nonnull_sum_count_1, t1_openivm_multiplicity) AS (
    SELECT    t8_region, sum(t8_amount), count_star(), count(t8_amount),
              CAST(t9_openivm_multiplicity AS INTEGER)
    FROM      t1_aggregate
    WHERE     t9_openivm_multiplicity != 0
    GROUP BY  t8_region, CAST(t9_openivm_multiplicity AS INTEGER)
)
INSERT INTO openivm_delta_<key>
    (region, total, cnt, openivm_nonnull_sum_count_1, openivm_multiplicity)
SELECT * FROM t2_block;`,
  },
  {
    label: '4 · ΔV → V',
    note: "The view's delta is folded with <code>SUM(multiplicity × value)</code> and merged on the group key; groups whose count drops to zero are deleted.",
    code: `WITH refresh_cte AS (
    SELECT region,
           sum(openivm_multiplicity * total) AS total,
           sum(openivm_multiplicity * cnt)   AS cnt,
           sum(openivm_multiplicity * openivm_nonnull_sum_count_1) AS openivm_nonnull_sum_count_1
    FROM   openivm_delta_<key>
    WHERE  openivm_timestamp > $last_update
    GROUP BY region
)
MERGE INTO openivm_data_<key> v USING refresh_cte d
ON v.region IS NOT DISTINCT FROM d.region
WHEN MATCHED THEN UPDATE SET
    total = CASE WHEN COALESCE(v.openivm_nonnull_sum_count_1 + d.openivm_nonnull_sum_count_1,
                               v.openivm_nonnull_sum_count_1, d.openivm_nonnull_sum_count_1) = 0
                 THEN NULL
                 ELSE COALESCE(v.total + d.total, v.total, d.total) END,
    cnt   = COALESCE(v.cnt + d.cnt, v.cnt, d.cnt),
    openivm_nonnull_sum_count_1 = COALESCE(v.openivm_nonnull_sum_count_1 + d.openivm_nonnull_sum_count_1,
                                           v.openivm_nonnull_sum_count_1, d.openivm_nonnull_sum_count_1)
WHEN NOT MATCHED THEN INSERT (region, total, cnt, openivm_nonnull_sum_count_1)
    VALUES (d.region, d.total, d.cnt, d.openivm_nonnull_sum_count_1);

DELETE FROM openivm_data_<key> WHERE COALESCE(cnt, 0) = 0;`,
  },
  {
    label: '5 · Publish',
    note: 'Only the affected groups are compared with the published table. Their signed difference replaces the old visible rows and is recorded as a delta, which is what downstream views consume.',
    code: `CREATE TEMP TABLE openivm_publish_changes_<key> AS
SELECT region, total, cnt, openivm_ordinal, SUM(openivm_publish_weight) AS openivm_publish_weight
FROM (
    SELECT *, -1 AS openivm_publish_weight            -- old visible rows of affected groups
    FROM openivm_visible_<key> v
    WHERE EXISTS (SELECT 1 FROM openivm_delta_<key> d WHERE v.region IS NOT DISTINCT FROM d.region)
    UNION ALL
    SELECT *, +1 FROM openivm_publish_next_<key>      -- their new rows
) signed_rows
GROUP BY region, total, cnt, openivm_ordinal
HAVING SUM(openivm_publish_weight) <> 0;

-- then: append the signed changes to openivm_delta_openivm_visible_<key>,
-- delete the old rows from openivm_visible_<key> and insert the new ones`,
  },
  {
    label: '6 · Cleanup',
    note: 'Consumed deltas are removed once every dependent view has moved past them, and the cursor advances to <code>MAX(timestamp) + 1µs</code> of what this refresh actually saw, not <code>now()</code>, so a concurrent insert is never skipped or applied twice.',
    code: `DELETE FROM openivm_delta_<key>;

DELETE FROM openivm_delta_sales
WHERE openivm_timestamp < (SELECT MIN(last_update) FROM openivm_delta_tables
                           WHERE table_name = 'openivm_delta_sales');

UPDATE openivm_delta_tables
SET last_update = COALESCE((SELECT MAX(openivm_timestamp) + INTERVAL '1 microsecond'
                            FROM openivm_delta_sales),
                           make_timestamp(epoch_us(now()))),
    last_refresh_ts = make_timestamp(epoch_us(now()))
WHERE view_name = '<key>' AND table_name = 'openivm_delta_sales';`,
  },
];

const deltaRows: [string, string, number, number][] = [
  ['US', 'Bolt', 50, 1],
  ['JP', 'Gear', 300, 1],
  ['EU', 'Gadget', 200, -1],
];

const DOCS = 'https://github.com/ila/openivm/blob/main/docs';
const deeper = [
  { t: 'Delta rules', d: 'How each operator is classified (linear, product, stateful, non-linear) and what state it needs.', href: `${DOCS}/internals/linearity.md` },
  { t: 'Operator coverage', d: 'Joins, aggregates, DISTINCT, semi/anti, windows, top-k: the delta rule and refresh strategy for each.', href: 'https://github.com/ila/openivm/tree/main/docs/operators' },
  { t: 'Optimizations', d: 'Empty-delta skipping, delta consolidation, insert-only fast paths, FK-aware pruning.', href: 'https://github.com/ila/openivm/tree/main/docs/optimizations' },
  { t: 'Refresh and pipelines', d: 'Refresh strategies, scheduled refresh, cascades and pipeline refresh.', href: 'https://github.com/ila/openivm/tree/main/docs/refresh' },
  { t: 'Limitations', d: 'What falls back to full refresh today, and why.', href: `${DOCS}/limitations.md` },
  { t: 'The paper', d: 'OpenIVM: a SQL-to-SQL Compiler for Incremental Computations. SIGMOD Companion 2024.', href: 'https://dl.acm.org/doi/10.1145/3626246.3654743' },
];
---

<Base
  title="How incremental view maintenance works · OpenIVM"
  description="How OpenIVM compiles SQL materialized views into incremental SQL: the Z-set model, delta tables, the architecture inside DuckDB, and the exact SQL generated for a refresh."
>
  <header class="page-head">
    <div class="container">
      <p class="eyebrow">How it works</p>
      <h1>A SQL-to-SQL compiler for incremental computation.</h1>
      <p class="lede">
        OpenIVM does not replace your engine. It reads your view definition and emits the SQL that keeps it up to
        date, so the same approach carries from DuckDB to Spark and beyond.
      </p>
    </div>
  </header>

  <section class="band">
    <div class="container model">
      <div>
        <h2>IVM in one equation.</h2>
        <p class="lede">
          Given a table <var>T</var> and a view <var>V</var> = <var>Q</var>(<var>T</var>), find a function{' '}
          <var>f</var> so that <var>f</var>(Δ<var>T</var>) = Δ<var>V</var>: compute the change to the view from the
          change to the table alone, instead of re-running <var>Q</var>.
        </p>
        <p class="lede">
          OpenIVM follows <a href="https://arxiv.org/abs/2203.16684">DBSP</a>, which gives such an <var>f</var> for
          arbitrary relational queries using two operators: differentiation <b>D</b> (Δ<var>T</var> = <var>T′</var> −{' '}
          <var>T</var>) and integration <b>I</b> (<var>T</var> + Δ<var>T</var> = <var>T′</var>). Each operator is
          replaced by its incremental form, and the plan runs over deltas.
        </p>
      </div>
      <div class="card eq-card">
        <div class="eq">
          <span class="eq-l"><var>V</var> = π(σ(<var>T</var>))</span>
          <span class="eq-arrow">⟶</span>
          <span class="eq-r">Δ<var>V</var> = π*(σ*(Δ<var>T</var>))</span>
        </div>
        <p class="eq-note">Selection and projection are their own incremental form; a join becomes three joins.</p>
        <div class="zs">
          <p class="zs-title">Changes add up: <var>R</var><sub>new</sub> = <var>R</var><sub>old</sub> + Δ<var>R</var>. For <code>regional_totals</code> (region → total):</p>
          <div class="zs-row"><span class="zs-k"><var>V</var></span><code>{'{'} US → 100, EU → 200 {'}'}</code></div>
          <div class="zs-row"><span class="zs-k">Δ<var>V</var></span><code>{'{'} US → <span class="plus">+50</span>, JP → <span class="plus">+300</span>, EU → <span class="minus">−200</span> {'}'}</code></div>
          <div class="zs-row sum"><span class="zs-k"><var>V</var> + Δ<var>V</var></span><code>{'{'} US → 150, JP → 300 {'}'}</code></div>
          <p class="eq-note">EU drops out: its only sale was deleted, so its row count reaches zero.</p>
        </div>
        <div class="alg">
          <p class="zs-title">…and every algebraic step is plain SQL</p>
          <div class="alg-row"><span>addition</span><code>UNION ALL</code><span class="dim">+ grouped weight sums</span></div>
          <div class="alg-row"><span>multiplication</span><code>JOIN</code><span class="dim">weights multiply</span></div>
          <div class="alg-row"><span>integration</span><code>MERGE</code><span class="dim">/ INSERT, DELETE</span></div>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="container zset">
      <div>
        <h2>Every change is a weighted row.</h2>
        <p class="lede">
          A delta table has the same columns as its source, plus a signed weight. An <code>INSERT</code> writes{' '}
          <code class="plus">+1</code>, a <code>DELETE</code> writes <code class="minus">−1</code>, and an{' '}
          <code>UPDATE</code> writes both (old row −1, new row +1), inside the same transaction as the DML. Operators then work on these
          weights algebraically: aggregates sum <code>weight × value</code>, joins multiply weights.
        </p>
        <p class="lede">
          Several views can share one delta table; each keeps its own cursor and reads only what it has not yet
          processed. Over <a href="https://ducklake.select/">DuckLake</a>, there is no delta table at all: changes
          are derived from table snapshots, and the pre-refresh state is read through time travel.
        </p>
      </div>
      <div class="card delta-card">
        <p class="cap">
          <code>SELECT * FROM openivm_delta_sales;</code>
        </p>
        <div class="table-wrap">
          <table class="data-table">
            <thead>
              <tr><th>region</th><th>product</th><th class="num">amount</th><th class="num">multiplicity</th></tr>
            </thead>
            <tbody>
              {
                deltaRows.map(([r, p, a, m]) => (
                  <tr>
                    <td>{r}</td>
                    <td class="mono">{p}</td>
                    <td class="num mono">{a}</td>
                    <td class:list={['num', 'mono', m > 0 ? 'plus' : 'minus']}>{m > 0 ? '+1' : '−1'}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="cap small">
          After two inserts and one delete. Timestamps omitted. Captured from the DuckDB extension.
        </p>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="container">
      <div class="section-head">
        <h2>A real engine underneath.</h2>
        <p class="lede">
          Most IVM compilers are detached prototypes that talk to a database through drivers. OpenIVM lives inside
          one: DuckDB parses, binds and plans the view, so the compiler gets schema validation, cardinality estimates
          and a cost model for free, and physical choices such as indexes or what to materialize stay tunable.
        </p>
      </div>
      <ArchDiagram />
      <ol class="flow-list">
        <li><b>Normalize.</b> Intercept <code>CREATE MATERIALIZED VIEW</code>, take the bound logical plan, and
          rewrite equivalent shapes into forms the delta rules handle.</li>
        <li><b>Model.</b> Build a <em>delta model</em>: each operator's rule kind, the state it needs, and its{' '}
          <em>lineage</em>, a mapping from an affected output key, group or window partition back to the source
          columns that can change it.</li>
        <li><b>Rewrite.</b> Turn source scans into deltas and propagate them operator by operator, restricting any
          recomputation to the exact domain lineage says was touched.</li>
        <li><b>Emit.</b> <a href="https://github.com/cwida/lpts">LPTS</a> (Logical Plan to SQL) turns the rewritten
          plan into a dialect-independent AST, flattens it into an ordered CTE program, and renders it for the target
          engine. OpenIVM decides <em>what</em> to compute; LPTS decides <em>how</em> to say it.</li>
      </ol>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="section-head">
        <h2>What a refresh actually runs.</h2>
        <p class="lede">
          One view definition becomes several SQL statements: compute Δ<var>V</var> from Δ<var>T</var>, fold
          Δ<var>V</var> into <var>V</var>, publish the rows that changed, then clear the consumed deltas. Below is what
          OpenIVM compiles for <code>regional_totals</code>, captured with <code>SET openivm_files_path</code>. Internal
          tables are named after a key derived from the view's catalog, schema and name, shown as <code>&lt;key&gt;</code>;
          catalog prefixes and literal timestamps are elided. It is ordinary SQL, which is what makes the approach
          portable.
        </p>
      </div>
      <CodeTabs id="compiled" label="Compiled SQL stages" tabs={compiled} />
    </div>
  </section>

  <section class="band">
    <div class="container">
      <div class="section-head">
        <h2>Maintain views across engines.</h2>
        <p class="lede">
          Modern pipelines span several systems: transactions in one, analytics in another. Because the maintenance
          steps are SQL, rendered by LPTS in each engine's dialect, they can be shipped to wherever the data lives
          instead of copying the data to wherever the IVM engine lives.
        </p>
      </div>
      <CrossSystemDiagram />
    </div>
  </section>

  <section>
    <div class="container">
      <div class="section-head">
        <h2>A view that only does the work that changed.</h2>
        <p class="lede">
          The view below is <code>SELECT region, SUM(amount), COUNT(*) FROM sales GROUP BY region</code>. Changes
          collect as signed deltas; a refresh folds them in. Insert then delete the same row and the deltas cancel
          out before any work is done.
        </p>
      </div>
      <DeltaDemo />
    </div>
  </section>

  <section class="band">
    <div class="container">
      <div class="section-head">
        <h2>Go deeper.</h2>
        <p class="lede">The full internals live in the repository docs, next to the code they describe.</p>
      </div>
      <div class="deeper">
        {
          deeper.map((x) => (
            <a class="card deep" href={x.href}>
              <h3>{x.t}</h3>
              <p>{x.d}</p>
              <span class="go">Read →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .band {
    background: var(--bg-2);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .model,
  .zset {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .model .lede + .lede,
  .zset .lede + .lede {
    margin-top: 14px;
  }
  var {
    font-family: 'Georgia', 'Times New Roman', serif;
    font-style: italic;
    font-size: 1.05em;
    padding: 0 0.12em 0 0.04em;
  }
  .eq-card {
    padding: 28px;
    display: grid;
    gap: 18px;
  }
  .eq {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 18px;
    font-size: 1.35rem;
    color: var(--text);
  }
  .eq-arrow {
    color: var(--insert);
  }
  .eq-r {
    color: var(--accent);
  }
  .eq-note {
    color: var(--faint);
    font-size: 0.88rem;
  }
  .zs,
  .alg {
    border-top: 1px solid var(--border);
    padding-top: 16px;
    display: grid;
    gap: 8px;
  }
  .zs-title {
    color: var(--muted);
    font-size: 0.85rem;
    margin-bottom: 4px;
  }
  .zs-row {
    display: grid;
    grid-template-columns: 90px 1fr;
    align-items: baseline;
  }
  .zs-row code {
    background: none;
    border: 0;
    padding: 0;
    color: var(--text);
  }
  .zs-k {
    color: var(--muted);
  }
  .zs-row.sum {
    border-top: 1px dashed var(--border-strong);
    padding-top: 8px;
  }
  .alg-row {
    display: grid;
    grid-template-columns: 110px auto 1fr;
    gap: 12px;
    align-items: baseline;
    color: var(--muted);
    font-size: 0.92rem;
  }
  .alg-row code {
    color: var(--insert);
  }
  .alg-row .dim {
    color: var(--faint);
    font-size: 0.85rem;
  }

  .delta-card {
    padding: 22px;
  }
  .cap {
    color: var(--muted);
    font-size: 0.9rem;
    margin-bottom: 12px;
  }
  .cap.small {
    margin: 12px 0 0;
    font-size: 0.8rem;
    color: var(--faint);
  }

  .flow-list {
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    counter-reset: flow;
  }
  .flow-list li {
    counter-increment: flow;
    color: var(--muted);
    font-size: 0.9rem;
    padding-top: 14px;
    border-top: 2px solid var(--border-strong);
  }
  .flow-list li::before {
    content: counter(flow, decimal-leading-zero);
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--insert);
    margin-bottom: 6px;
  }
  .flow-list b {
    color: var(--text);
  }

  .deeper {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }
  .deep {
    padding: 22px;
    display: grid;
    gap: 10px;
    align-content: start;
    color: var(--text);
    transition: border-color 0.15s, transform 0.15s;
  }
  .deep:hover {
    text-decoration: none;
    border-color: var(--border-strong);
    transform: translateY(-2px);
  }
  .deep h3 {
    font-size: 1.05rem;
  }
  .deep p {
    color: var(--muted);
    font-size: 0.9rem;
  }
  .go {
    color: var(--insert);
    font-weight: 600;
    font-size: 0.9rem;
  }

  @media (max-width: 960px) {
    .model,
    .zset {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .flow-list,
    .deeper {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .flow-list,
    .deeper {
      grid-template-columns: 1fr;
    }
  }
</style>
