---
// Mark: a delta drawn as a refresh loop; only the last stretch (pink) is redrawn, like an incremental refresh.
interface Props {
  size?: number;
}
const { size = 26 } = Astro.props;
---

<svg viewBox="0 0 64 64" width={size} height={size} aria-hidden="true">
  <g fill="none" stroke-width="6" stroke-linejoin="round" stroke-linecap="round">
    <path d="M22 50H9L32 10 45.8 34" stroke="var(--accent)" opacity=".6"></path>
    <path d="M49.48 40.4 55 50H40" stroke="var(--insert)"></path>
  </g>
  <path d="M31 50 38.5 43.5V56.5Z" fill="var(--insert)" stroke="var(--insert)" stroke-width="2" stroke-linejoin="round"></path>
</svg>
