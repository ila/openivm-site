---
// Mark: two deltas, the old state (lavender) and the new state (pink), offset by the change.
interface Props {
  size?: number;
}
const { size = 26 } = Astro.props;
---

<svg viewBox="0 0 64 64" width={size} height={size} aria-hidden="true">
  <g transform="translate(-0.5 5)">
  <path d="M28 14.06 47 46.97H9Z" fill="none" stroke="var(--accent)" stroke-width="5" stroke-linejoin="round" opacity=".55"></path>
  <path d="M37 9.06 56 41.97H18Z" fill="none" stroke="var(--insert)" stroke-width="5" stroke-linejoin="round"></path>
  </g>
</svg>
